<view class="page"><view class="eyebrow">55块2 · 我的</view><view class="title">设置</view><view wx:if="{{config}}" class="card"><view class="section-title">计划参数</view><view class="list-row"><text>每日额度</text><text class="value">¥{{config.dailyBudget}}</text></view><view class="list-row"><text>日薪</text><text class="value">¥{{config.salaryPerDay / 100}}</text></view><view class="list-row"><text>计薪周期</text><text class="secondary-text">21日 — 20日</text></view><view class="list-row"><text>截止日</text><text class="secondary-text">{{config.deadline}}</text></view><view class="list-row"><text>最低目标</text><text class="value">¥{{config.goalMinimum}}</text></view></view><view class="card"><view class="section-title">数据与隐私</view><view class="caption">所有流水保存在本机，不使用云服务。</view><view class="list-row"><text>已记录支出</text><text class="value">{{expenseCount}} 笔</text></view><button class="button secondary" bindtap="exportCsv">复制 CSV 数据</button><button class="button reset-button" bindtap="resetData">重置演示数据</button></view></view>
