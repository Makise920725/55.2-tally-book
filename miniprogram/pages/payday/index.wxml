<view class="page"><view class="eyebrow">55块2 · 发薪日 SOP</view><view class="title">发薪日</view><view wx:if="{{period}}" class="card"><view class="caption">到账日 {{period.payDate}}　·　五步完成，安心进入下一期</view><view wx:for="{{steps}}" wx:key="index" class="sop-row {{item.done ? 'done' : ''}}" data-step="{{item.index}}" bindtap="toggleStep"><view class="check">{{item.done ? '✓' : ''}}</view><view class="sop-copy"><view>{{item.index}}　{{item.name}}</view><view class="secondary-text wx-value">{{item.amount}}</view></view></view><button class="button {{completed ? 'button-complete' : ''}}" style="margin-top: 24rpx;">{{completed ? '本期已完成' : '五步完成'}}</button></view></view>
