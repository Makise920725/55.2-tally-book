<view class="page">
  <view class="eyebrow">55块2 · 发薪日 SOP</view>
  <view class="title">发薪日</view>
  <view wx:if="{{saveError}}" class="card save-error"><view class="section-title">未保存</view><view class="caption">{{saveError}}</view></view>
  <picker mode="selector" range="{{periodOptions}}" value="{{periodIndex - 1}}" bindchange="togglePeriod"><view class="period-picker">{{periodOptions[periodIndex - 1]}}　⌄</view></picker>
  <view wx:if="{{period}}" class="card">
    <view class="caption">工资日 {{period.payDate}}　·　生活费预计 {{period.allowanceExpectedDate}}　·　{{statusText}}</view>
    <view wx:for="{{steps}}" wx:key="index" class="sop-row {{item.done ? 'done' : ''}} {{item.index === 6 ? 'derived' : ''}}" data-step="{{item.index}}" bindtap="toggleStep">
      <view class="check">{{item.done ? '✓' : ''}}</view>
      <view class="sop-copy">
        <view>{{item.index}}　{{item.name}}<text wx:if="{{item.index === 6}}" class="derived-tag">真实转账</text></view>
        <view class="secondary-text wx-value">{{item.flowText}}</view>
      </view>
    </view>
    <view wx:if="{{period.allowanceHint}}" class="caption allowance-hint">{{period.allowanceHint}}</view>
    <button wx:if="{{!period.salaryReceived}}" class="button" style="margin-top: 24rpx;" disabled="{{!canRegisterSalary}}" bindtap="registerSalary">{{salaryButtonText}}</button>
    <button wx:if="{{period.salaryReceived && !period.allowanceReceived}}" class="button" style="margin-top: 24rpx;" disabled="{{!canRegisterAllowance}}" bindtap="registerAllowance">{{allowanceButtonText}}</button>
    <picker wx:if="{{period.salaryReceived && !period.allowanceReceived && canRegisterAllowance}}" mode="date" value="{{allowancePickerValue}}" start="{{period.payDate}}" end="{{allowancePickerEnd}}" bindchange="registerAllowance"><view class="caption date-picker">生活费实际到账日默认今天；若换过手机日期不对，点这里按真实日期登记（{{period.payDate}} → {{period.rangeEnd}}）</view></picker>
    <view wx:if="{{period.fullyFunded}}" class="caption allowance-hint">两笔收入已按「账单 → 预算池 → 储蓄」安置完毕</view>
    <view wx:if="{{legacyHint}}" class="caption allowance-hint">{{legacyHint}}</view>
    <button wx:if="{{canSweep}}" class="button secondary" style="margin-top: 16rpx;" bindtap="sweepSurplus">{{sweepText}}</button>
  </view>
</view>
