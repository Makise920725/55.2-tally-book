<view class="page"><view class="eyebrow">55块2 · 发薪日 SOP</view><view class="title">发薪日</view><view wx:if="{{period}}" class="card"><view class="caption">到账日 {{period.payDate}}　·　五步完成，安心进入下一期</view><view wx:for="{{steps}}" wx:key="index" class="sop-row {{item.done ? 'done' : ''}}" data-step="{{item.index}}" bindtap="toggleStep"><view class="check">{{item.done ? '✓' : ''}}</view><view class="sop-copy"><view>{{item.index}}　{{item.name}}</view><view class="secondary-text wx-value" wx:if="{{item.index === 1}}">¥{{period.total}}</view><view class="secondary-text wx-value" wx:elif="{{item.index === 2}}">¥{{period.bill}}</view><view class="secondary-text wx-value" wx:elif="{{item.index === 3}}">¥{{period.budget}}</view><view class="secondary-text wx-value" wx:elif="{{item.index === 4}}">¥{{period.save}}</view><view class="secondary-text" wx:else>省多少转多少</view></view></view><button class="button" style="margin-top: 24rpx;">五步完成</button></view></view>
