<view class="page"><view class="eyebrow">55块2 · 本期</view><view class="title">本期</view><view wx:if="{{current}}" class="card"><view class="caption">本期预算池</view><view class="amount">¥ {{current.budget}}</view><view class="list-row"><text>已记支出</text><text class="value">¥{{current.spent}}</text></view><view class="list-row"><text>预计余粮</text><text class="value">¥{{current.left}}</text></view><view class="caption">{{current.rangeStart}} → {{current.rangeEnd}}　·　{{current.days}} 天</view></view><view wx:if="{{current}}" class="card"><view class="section-title">每日节奏</view><view class="list-row"><text>{{current.modeText}}</text><text class="value">一次 ¥{{current.allocation}}</text></view><view class="daily-bars"><view wx:for="{{current.series}}" wx:key="date" class="daily-bar-wrap"><view class="daily-bar {{item.over ? 'over' : (item.used ? 'used' : '')}}" style="height: {{item.height}}%;"></view></view></view><view class="caption">灰色是未使用，黑色是已记录，斜纹表示超过 ¥55.19</view></view><view class="section-label">五期储蓄轨迹</view><block wx:for="{{periods}}" wx:key="index"><view class="card period-card"><view class="list-row"><view><view>第 {{item.index}} 期</view><view class="secondary-text">{{item.payDate}}　·　{{item.days}} 天</view></view><view class="value">¥ {{item.save}}</view></view><view class="caption">累计储蓄 ¥{{item.pocket}}　·　账单 ¥{{item.bill}}</view></view></block></view>
