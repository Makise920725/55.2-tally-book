.amount { color: var(--ink); }
.target-line { display: flex; justify-content: space-between; color: var(--dim); font-family: "Noto Serif SC", "Songti SC", serif; font-size: 21rpx; }
.progress-target { position: relative; }
.goal-marker { position: absolute; top: -8rpx; width: 3rpx; height: 24rpx; background: var(--ink); }
.special-input { margin: 14rpx 0; padding: 22rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: var(--paper); }
.pocket-empty { display: block; margin: 16rpx 0 4rpx; }
