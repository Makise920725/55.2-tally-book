<view class="page">
  <view class="eyebrow">55块2 · 今日</view>
  <view class="title">今天还能花</view>
  <view wx:if="{{saveError}}" class="card save-error"><view class="section-title">未保存</view><view class="caption">{{saveError}}</view></view>
  <view wx:if="{{!started}}" class="card prestart"><view class="caption">计划尚未开始</view><view class="amount">还有 {{daysToStart}} 天</view><view class="caption">第一期工资到账日：2026-09-24</view></view>
  <view wx:elif="{{ended}}" class="card prestart"><view class="caption">五期计划已结束</view><view class="amount">已完成</view><view class="caption">计划截止日：{{deadline}}，可在“储蓄”和“我的”中查看或导出记录。</view></view>
  <view wx:if="{{todos.length}}" class="card todo-card">
    <view class="section-title">今天还差 {{todos.length}} 件事</view>
    <view wx:for="{{todos}}" wx:key="key" class="todo-row"><text class="todo-dot">·</text><text class="todo-text">{{item.text}}</text></view>
  </view>
  <view wx:if="{{active}}" class="card hero"><view class="caption">今天还能花</view><view class="amount">¥ {{remaining}}</view><view class="caption">额度 ¥{{dailyBudget}}　·　轻盈记录，按自己的节奏</view><view class="progress"><view class="progress-fill" style="width: {{remaining / dailyBudget * 100}}%;"></view></view></view>
  <view wx:if="{{active}}" class="card">
    <view class="section-title">记一笔</view>
    <view class="categories"><button wx:for="{{categories}}" wx:key="id" class="category {{selectedCategory === item.id ? 'selected' : ''}}" data-category="{{item.id}}" data-name="{{item.name}}" bindtap="selectCategory"><text class="category-mark">{{item.mark}}</text><text>{{item.name}}</text></button></view>
    <view class="amount-input" bindtap="openKeyboard"><text class="amount-preview">¥ {{keypadAmount}}</text><text class="amount-hint">{{selectedCategoryName}}　·　点击输入金额</text></view>
    <button class="button" bindtap="addExpense">保存支出</button>
  </view>
  <view class="card">
    <view class="section-title">今日全部账务变化</view>
    <view wx:if="{{summary && summary.count}}" class="flow-summary">
      <text class="chip">支出 ¥{{summary.expense}}</text>
      <text class="chip">划入 ¥{{summary.transferIn}}</text>
      <text class="chip">补差 ¥{{summary.cover}}</text>
      <text class="chip">退款 ¥{{summary.refund}}</text>
      <text class="chip">专项 ¥{{summary.special}}</text>
      <text class="chip" wx:if="{{summary.adjust}}">校准 {{summary.adjust}}</text>
    </view>
    <view wx:if="{{entries.length === 0}}" class="muted">还没有记录</view>
    <view wx:for="{{entries}}" wx:key="id" class="flow-row">
      <view class="flow-body">
        <view class="flow-title"><text class="flow-tag">{{item.typeLabel}}</text>{{item.title}}</view>
        <view class="flow-sub">{{item.flowText}}<text wx:if="{{item.note}}">　·　{{item.note}}</text></view>
        <view class="flow-time">{{item.eventDate}}　{{item.timeShort}}</view>
      </view>
      <view class="flow-side"><view class="flow-amount {{item.signedFen > 0 ? 'inflow' : (item.signedFen < 0 ? 'outflow' : 'neutral')}}">{{item.amountText}}</view></view>
    </view>
    <button class="button secondary flow-more" bindtap="openLedger">查看今日全部流水</button>
  </view>
  <button wx:if="{{active}}" class="button secondary settle" bindtap="allocateDay">早间划额　·　从余额宝转入工资卡（批次首日漏划可在本批任意一天补上）</button>
  <button wx:if="{{active && !closed}}" class="button secondary settle" bindtap="settleDay">晚间结算　·　退回余额宝</button>
  <button wx:elif="{{active && closed}}" class="button secondary settle" bindtap="reopenDay">已封账　·　撤销一次</button>
</view>
<view wx:if="{{keyboardVisible}}" class="keypad-mask" bindtap="closeKeyboard"><view class="keypad-sheet" catchtap="noop"><view class="keypad-label">{{selectedCategoryName}}</view><view class="keypad-value">¥ {{keypadAmount}}</view><view class="keypad"><button wx:for="{{keyRows}}" wx:key="*this" data-key="{{item}}" bindtap="keypress">{{item === 'delete' ? '⌫' : item}}</button></view><button class="button keypad-ok" bindtap="addExpense">完成</button><view class="keypad-cancel" bindtap="closeKeyboard">取消</view></view></view>
