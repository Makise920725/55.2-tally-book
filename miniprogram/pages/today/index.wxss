.hero { padding: 48rpx 32rpx; text-align: center; }
.categories { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.category { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 112rpx; margin: 0; padding: 12rpx 4rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--paper); color: var(--ink-2); font-size: 22rpx; line-height: 1.4; }
.category.selected { border-color: var(--ink); background: var(--ink); color: #fff; }
.category-mark { margin-bottom: 4rpx; font-family: "Noto Serif SC", "Songti SC", serif; font-size: 34rpx; color: var(--ink); }
.category.selected .category-mark { color: #fff; }
.amount-input { margin: 26rpx 0; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--paper); }
.settle { margin-bottom: 24rpx; }
.entry { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); font-size: 25rpx; }
.entry:last-child { border-bottom: 0; }
